<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>OpenUCL.Gui</RootNamespace>
    <AssemblyName>OpenUCL</AssemblyName>
    <Description>OpenUCL desktop application (Avalonia, Windows/macOS/Linux).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.*" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.*" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenUCL.Core\OpenUCL.Core.csproj" />
    <ProjectReference Include="..\OpenUCL.Data\OpenUCL.Data.csproj" />
  </ItemGroup>

</Project>
